# Copy to .env or export these variables before running experiments.
# The scripts accept any OpenAI-compatible chat-completion endpoint.

# Shared generator LLM endpoint used for all model families unless overridden.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=replace-with-your-key

# Optional judge-specific endpoint. If unset, the judge reuses LLM_BASE_URL / LLM_API_KEY.
JUDGE_LLM_BASE_URL=https://api.example.com/v1
JUDGE_LLM_MODEL=deepseek-chat
JUDGE_LLM_API_KEY=replace-with-your-judge-key

# Optional per-family overrides. The variable name is the LLM slug uppercased,
# with non-alphanumeric characters replaced by underscores.
# DEEPSEEK_CHAT_BASE_URL=https://api.example.com/v1
# DEEPSEEK_CHAT_API_KEY=replace-with-your-key
# GPT_4O_MINI_BASE_URL=https://api.openai.com/v1
# GPT_4O_MINI_API_KEY=replace-with-your-key

# Optional path overrides. Defaults point inside this repository.
# SCOPE_NEW_MODEL_DIR=/absolute/path/to/SCOPE_code/SCOPE
# SCOPE_BASELINE_DIR=/absolute/path/to/SCOPE_code/baseline
# SCOPE_ABLA_BASELINE_DIR=/absolute/path/to/SCOPE_code/wo_abla
# SCOPE_EVAL_DIR=/absolute/path/to/SCOPE_code/eval
# SCOPE_QA_BENCH=/absolute/path/to/SCOPE_code/SCOPE/qa_bench
# SCOPE_RESULT_ROOT=/absolute/path/to/main/results
# SCOPE_ABLA_RESULT_ROOT=/absolute/path/to/ablation/results
